package main
import "crypto/x509"
import "crypto/sha256"
var failures = 0
func check(_ ok: bool, _ m: string) { if ok { print("ok    \(m)") } else { print("FAIL  \(m)"); failures += 1 } }
func main() -> int32 {
    print("=== x509 (real VM cert) ===")
    let der: [uint8] = [48,130,2,244,48,130,1,220,160,3,2,1,2,2,16,110,245,197,142,32,172,151,148,71,158,195,163,214,235,72,18,48,13,6,9,42,134,72,134,247,13,1,1,11,5,0,48,35,49,33,48,31,6,3,85,4,3,19,24,105,110,115,116,97,110,99,101,45,50,48,50,54,48,57,50,49,45,48,53,52,49,52,55,48,30,23,13,50,54,48,57,50,48,48,53,52,54,51,54,90,23,13,50,55,48,51,50,50,48,53,52,54,51,54,90,48,35,49,33,48,31,6,3,85,4,3,19,24,105,110,115,116,97,110,99,101,45,50,48,50,54,48,57,50,49,45,48,53,52,49,52,55,48,130,1,34,48,13,6,9,42,134,72,134,247,13,1,1,1,5,0,3,130,1,15,0,48,130,1,10,2,130,1,1,0,211,6,127,146,96,18,182,81,68,158,106,90,174,100,39,73,225,74,196,143,44,200,139,58,214,87,250,59,161,193,217,126,138,164,95,119,49,141,203,118,200,14,113,232,84,47,99,129,90,45,48,150,214,55,206,228,242,151,38,249,0,120,228,250,147,68,179,119,118,68,146,214,214,204,200,69,164,176,177,7,125,232,62,66,164,61,16,14,71,81,100,14,202,244,223,228,184,105,142,78,83,61,241,121,106,59,238,221,251,242,7,167,98,7,223,202,150,225,25,229,251,169,115,14,199,28,84,159,100,115,117,248,167,79,34,196,111,113,158,212,1,244,201,51,232,215,233,166,13,101,121,189,141,29,236,34,124,64,76,202,127,55,192,191,160,122,241,77,222,133,186,251,64,132,176,150,169,109,10,179,3,172,80,150,161,248,202,166,32,187,136,212,252,239,7,171,223,76,167,185,219,62,46,11,122,120,0,166,181,200,51,230,174,119,62,62,96,230,42,105,219,46,169,1,186,73,230,83,14,20,166,176,50,49,2,44,10,185,57,134,189,122,128,79,190,123,192,120,81,254,113,85,73,70,59,1,2,3,1,0,1,163,36,48,34,48,19,6,3,85,29,37,4,12,48,10,6,8,43,6,1,5,5,7,3,1,48,11,6,3,85,29,15,4,4,3,2,4,48,48,13,6,9,42,134,72,134,247,13,1,1,11,5,0,3,130,1,1,0,127,105,134,15,126,78,194,212,176,10,177,158,11,3,244,200,101,159,67,49,254,8,151,177,239,240,203,156,164,161,65,198,36,143,80,87,208,241,17,99,137,194,96,90,63,56,227,155,240,180,181,150,166,167,7,119,28,107,43,84,243,125,177,212,108,40,196,192,80,232,77,70,252,78,110,168,54,230,242,139,6,1,133,248,5,111,219,11,222,15,245,231,52,68,154,92,166,70,154,104,38,93,185,159,177,3,41,30,144,139,220,63,109,128,138,83,203,252,57,28,40,67,131,153,16,187,124,193,193,77,86,137,157,202,62,30,71,145,177,160,5,119,68,80,128,1,103,167,174,185,51,240,82,220,189,245,127,154,27,144,50,246,140,160,121,225,72,173,36,22,152,28,96,78,119,70,155,148,46,236,198,62,70,69,20,126,155,204,32,146,162,246,164,129,113,24,69,107,47,44,154,20,153,0,223,247,200,217,150,206,158,25,211,105,118,71,246,153,12,205,67,9,83,26,213,216,80,160,126,210,24,189,197,136,107,120,104,56,110,81,250,195,72,28,7,135,157,108,118,125,183,80,105,24,214,52]
    do {
        let cert = try x509.Parse(der)
        print("  subject: \(cert.Subject)")
        print("  issuer:  \(cert.Issuer)")
        print("  notBefore: \(cert.NotBefore)  notAfter: \(cert.NotAfter)")
        print("  RSA modulus bytes: \(cert.RSAPublicKey.Size)")
        print("  subjectPublicKey bytes: \(cert.RawSubjectPublicKey.count)")
        check(cert.IsRSA, "cert is RSA")
        check(cert.RSAPublicKey.Size == 256, "RSA-2048 modulus")
        check(cert.Subject == "instance-20260921-054147", "subject CN")
        check(cert.SignatureAlgorithm == .sha256RSA || cert.SignatureAlgorithm == .rsaPSS, "sig alg recognized")
        // Self-signed: verify the cert's signature against its own key.
        try x509.VerifySignedBy(cert, cert.RSAPublicKey)
        check(true, "self-signature verifies (RSA PKCS#1 v1.5)")
    } catch {
        check(false, "threw \(error)")
    }
    if failures > 0 { print("\(failures) FAILURES"); return 1 }
    print("all x509 tests passed")
    return 0
}
